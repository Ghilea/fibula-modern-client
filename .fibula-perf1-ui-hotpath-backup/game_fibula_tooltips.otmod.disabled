Module
  name: game_fibula_tooltips
  description: Modern dark fantasy tooltips for Fibula items and actionbars
  author: Fibula Modern Client
  version: 0.1.0

  autoload: true
  autoload-priority: 1680
  sandboxed: true
  dependencies: [ game_interface, game_actionbar ]
  scripts: [ tooltips ]

  @onLoad: FibulaTooltips.init()
  @onUnload: FibulaTooltips.terminate()
