Module
  name: game_wowpopup
  description: WoW-style floating inventory, minimap and bag hotkeys for Fibula
  author: Fibula Modern Client
  version: 0.2.0

  autoload: true
  autoload-priority: 1150
  sandboxed: true
  scripts: [ wowpopup ]

  @onLoad: WowPopup.init()
  @onUnload: WowPopup.terminate()
