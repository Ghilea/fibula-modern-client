Module
  name: game_wowpopup
  description: Clean WoW-style character, utility dock, minimap and bag layout for Fibula
  author: Fibula Modern Client
  version: 0.6.0

  autoload: true
  autoload-priority: 1150
  sandboxed: true
  scripts: [ wowpopup ]

  @onLoad: WowPopup.init()
  @onUnload: WowPopup.terminate()
