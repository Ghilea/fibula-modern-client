Module
  name: game_fibula_autostack
  description: Auto-stack stackable rewards created by fishing and other carried tools
  author: Fibula Modern Client
  version: 0.1.0

  autoload: true
  autoload-priority: 1580
  sandboxed: true
  dependencies: [ game_interface, game_containers, game_actionbar ]
  scripts: [ autostack ]

  @onLoad: FibulaAutoStack.init()
  @onUnload: FibulaAutoStack.terminate()
