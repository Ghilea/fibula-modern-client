Module
  name: game_fibula_workspace
  description: Workspace-only persistent container positions and nested bag restore
  author: Fibula Modern Client
  version: 0.1.2
  autoload: true
  autoload-priority: 1800
  sandboxed: true
  dependencies: [ game_interface, game_containers, game_inventory, game_wowpopup ]
  scripts: [ workspace ]

  @onLoad: FibulaWorkspace.init()
  @onUnload: FibulaWorkspace.terminate()
