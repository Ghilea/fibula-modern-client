Module
  name: game_fibula_bagpolish
  description: Clean compact backpack and bag windows for Fibula
  author: Fibula Modern Client
  version: 0.1.0

  autoload: true
  autoload-priority: 1450
  sandboxed: true
  dependencies: [ game_interface, game_containers, game_fibula_qol ]
  scripts: [ bagpolish ]

  @onLoad: FibulaBagPolish.init()
  @onUnload: FibulaBagPolish.terminate()
